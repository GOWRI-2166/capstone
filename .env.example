# ============================================================
# Universal AI Guardrail - Environment Configuration Template
# Copy this file to .env and adjust values for your deployment
# ============================================================

# Project & Service Info
PROJECT_NAME="Universal AI Guardrail"
VERSION="1.0.0-production"
API_V1_STR="/api/v1"

# Server Host and Port
PORT=8000
HOST="0.0.0.0"

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL="sqlite:///./guardrail.db"

# Security & Authentication (Change in production)
JWT_SECRET="guardrail-production-secure-jwt-secret-key-2026-xyz"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
API_KEY_SECRET="guardrail-internal-api-secret-key-2026-xyz"

# Guardrail Risk Decision Thresholds
# Score < 0.40 -> ALLOW
# 0.40 <= Score < 0.70 -> REVIEW / WARN
# Score >= 0.70 -> BLOCK
RISK_THRESHOLD_LOW=0.40
RISK_THRESHOLD_HIGH=0.70

# Operational Mode
# DEMO_MODE=false for strict production JWT auth and live AI evaluation
# DEMO_MODE=true for testing/demo environments
DEMO_MODE=false
SEED_DEMO_DATA=false

# Downstream AI Provider Configuration
# Supported options: 'demo' (mock intelligent responses), 'openai', 'gemini'
AI_PROVIDER="demo"

# OpenAI Configuration (Optional - only required if AI_PROVIDER=openai)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini Configuration (Optional - only required if AI_PROVIDER=gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Allowed CORS Origins for Development
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000", "http://127.0.0.1:8000", "http://127.0.0.1:5173"]
