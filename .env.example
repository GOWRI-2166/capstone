# Universal AI Guardrail Configuration Example
# Copy this file to .env and customize for your environment

# Project & API Settings
PROJECT_NAME="Universal AI Guardrail API"
VERSION="1.0.0-phase1"
API_V1_STR="/api/v1"

# Server Port and Host
PORT=8000
HOST="0.0.0.0"

# Database Configuration (SQLite by default, or PostgreSQL)
DATABASE_URL="sqlite:///./guardrail.db"
# DATABASE_URL="postgresql://username:password@localhost:5432/guardrail_db"

# Security & Authentication Secrets (Replace with strong random secrets in production)
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
API_KEY_SECRET="your-api-key-secret-change-in-production"

# Risk Thresholds
RISK_THRESHOLD_LOW=0.40
RISK_THRESHOLD_HIGH=0.70
