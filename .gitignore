# ==========================================
# Universal AI Guardrail - Root .gitignore
# ==========================================

# Environments & Virtual Envs
.venv/
venv/
env/
ENV/
Include/
Lib/
Scripts/
pyvenv.cfg

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node & Frontend Build Dependencies
frontend/node_modules/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Local SQLite Database Files (keep schema & seeds, ignore runtime DB)
guardrail.db
*.sqlite
*.sqlite3
*.db-journal

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs and runtime artifacts
logs/
*.log
scratch/
